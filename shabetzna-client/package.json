{
  "name": "shabetzna-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 7070",
    "build": "vite build",
    "buildWithLint": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "node -e \"process.env.NODE_ENV !== 'production' && require('child_process').execSync('npx playwright install chromium')\" || true"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@tanstack/react-query": "^5.51.24",
    "axios": "^1.7.4",
    "class-names": "^1.0.0",
    "dateformat": "^5.0.3",
    "lodash": "^4.17.21",
    "posthog-js": "^1.268.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.53.0",
    "react-onesignal": "^3.0.1",
    "react-router-dom": "^6.26.1",
    "stylis": "^4.3.4",
    "stylis-plugin-rtl": "^2.1.1",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-vercel": "^9.0.1",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tanstack/eslint-plugin-query": "^5.51.15",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dateformat": "^5.0.2",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^0.34.6",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^22.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vitest": "^0.34.5"
  }
}
